# "testnet" (the default) reads the deployed contracts and each chain over public RPCs and signs
# with a real NEAR wallet through near-connect. "mock" runs entirely in the browser with simulated
# chains and demo accounts, no wallet needed (everything is labelled SIMULATED).
NEXT_PUBLIC_NETWORK=testnet

# The locked contract the live site runs on (the default). Its market, schedule, lending and switch
# contracts come with it; point this at another deployment to try one.
NEXT_PUBLIC_BEARER_CONTRACT=bearer.testnet
# Testnet endpoints (these are the defaults; all public and keyless).
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
NEXT_PUBLIC_ESPLORA_API=https://blockstream.info/testnet4/api
NEXT_PUBLIC_BASE_RPC=https://sepolia.base.org
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SIGNER_CONTRACT=v1.signer-prod.testnet
NEXT_PUBLIC_CODE_HASH=

# Vault names (docs/features/names.md): the names contract and the TLA it rents under. With
# bearer.testnet these default to bearer-names.testnet and bearer-tla.testnet; leave them empty.
NEXT_PUBLIC_NAMES_CONTRACT=
NEXT_PUBLIC_TLA_ROOT=
NEXT_PUBLIC_TLA_REGISTRY=

# Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, the footer and Technical details link to GitHub and docs/THREAT_MODEL.md.
NEXT_PUBLIC_REPO_URL=

# Server only, never NEXT_PUBLIC_: a NEAR AI Cloud key (cloud.near.ai) for risk notes on loans
# (docs/features/risk-note.md). Without it, only the enclave check runs. NEAR_AI_MODEL picks another
# open model NEAR AI serves from its own TEEs.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Contract spikes and testnet scripts (contracts/tests/spike). Account names only;
# keys stay in ~/.near-credentials/testnet. BEARER_TESTNET_PREFIX names the contract
# subaccount (v3a, v3b, …): deploy fresh accounts, never upgrade a locked one.
BEARER_TESTNET_PARENT=
BEARER_TESTNET_PREFIX=v3a
# The web app's /nft route, e.g. https://bearer.example/nft: each token's media is {base_uri}/{id}.svg.
BEARER_MEDIA_BASE_URI=

# The mainnet deployment (docs/features/mainnet.md): the account it runs on, for the token images
# at /nft/mainnet/{id}.svg. Server-only. Empty: those images answer 404.
MAINNET_BEARER_CONTRACT=
