# "mock" runs entirely in the browser with simulated chains (everything is labelled SIMULATED).
# "testnet" needs @bearer/sdk and a deployed contract (not built yet).
NEXT_PUBLIC_NETWORK=mock

NEXT_PUBLIC_BEARER_CONTRACT=bearer-v1.testnet
NEXT_PUBLIC_SIGNER_CONTRACT=v1.signer-prod.testnet
NEXT_PUBLIC_CODE_HASH=

# Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, the footer and Technical details link to GitHub and docs/THREAT_MODEL.md.
NEXT_PUBLIC_REPO_URL=

# Contract spikes and testnet scripts (contracts/tests/spike). Account names only;
# keys stay in ~/.near-credentials/testnet. BEARER_TESTNET_PREFIX names the contract
# subaccount (v3a, v3b, …): deploy fresh accounts, never upgrade a locked one.
BEARER_TESTNET_PARENT=
BEARER_TESTNET_PREFIX=v3a
# The web app's /nft route, e.g. https://bearer.example/nft: each token's media is {base_uri}/{id}.svg.
BEARER_MEDIA_BASE_URI=
